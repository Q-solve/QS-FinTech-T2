# ============================================================

for year, df in cleaned_datasets.items():

    non_numeric = []

    for col in df.columns:
        if col == "Date":
            continue

        original = df[col]
        converted = pd.to_numeric(original, errors="coerce")

        # Values that were not originally missing
        # but became NaN after conversion
        problem = original.notna() & converted.isna()

        if problem.any():
            non_numeric.append(col)

    print(
        year,
        "| Columns with unexpected non-numeric values:",
        len(non_numeric)
    )

    if non_numeric:
        print(non_numeric)


# ============================================================
# STEP 31: COMBINE ALL 8 YEARS
# ============================================================

all_years = [
    2013,
    2015,
    2017,
    2020,
    2021,
    2023,
    2024,
    2025
]

master_df = pd.concat(
    [cleaned_datasets[year] for year in all_years],
    axis=0,
    ignore_index=True,
    sort=False
)

# Sort by date
master_df = master_df.sort_values(
    "Date"
).reset_index(drop=True)

print("Master dataset shape:", master_df.shape)

print("\nFirst 5 rows:")
display(master_df.head())

print("\nLast 5 rows:")
display(master_df.tail())


# ============================================================
# STEP 32: CHECK MASTER DATE RANGE
# ============================================================

print("First date:", master_df["Date"].min())
print("Last date:", master_df["Date"].max())

print("Total rows:", len(master_df))
print("Unique dates:", master_df["Date"].nunique())

print(
    "Duplicate dates:",
    master_df["Date"].duplicated().sum()
)


# ============================================================
# STEP 33: CHECK MASTER COLUMNS
# ============================================================

print("Total columns:", len(master_df.columns))

print("\nAll columns:")
for i, col in enumerate(master_df.columns, start=1):
    print(i, "-", col)


# ============================================================
# STEP 34: CHECK DUPLICATE COLUMN NAMES
# ============================================================

duplicate_columns = master_df.columns[
    master_df.columns.duplicated()
].tolist()

print("Duplicate column names:", len(duplicate_columns))

if duplicate_columns:
    print(duplicate_columns)
else:
    print("SUCCESS: No duplicate column names.")


# ============================================================
# STEP 35: FINAL MISSING VALUE ANALYSIS
# ============================================================

missing_summary = pd.DataFrame({
    "Missing_Count": master_df.isna().sum(),
    "Total_Rows": len(master_df),
})

missing_summary["Missing_Percentage"] = (
    missing_summary["Missing_Count"]
    / missing_summary["Total_Rows"]
    * 100
)

missing_summary = missing_summary.sort_values(
    "Missing_Percentage",
    ascending=False
)

print("Missing-value summary:")
display(missing_summary.head(20))


# ============================================================
# STEP 36: CHECK COMPLETELY EMPTY COLUMNS
# ============================================================

empty_columns = [
    col
    for col in master_df.columns
    if master_df[col].isna().all()
]

print("Completely empty columns:", len(empty_columns))

if empty_columns:
    print(empty_columns)
else:
    print("SUCCESS: No completely empty columns.")


# ============================================================
# STEP 37: OBSERVATIONS PER SECURITY
# ============================================================

observation_summary = pd.DataFrame({
    "Observations": master_df.notna().sum(),
    "Missing": master_df.isna().sum()
})

observation_summary = observation_summary.drop(
    index="Date"
)

observation_summary = observation_summary.sort_values(
    "Observations",
    ascending=False
)

display(observation_summary)


# ============================================================
# STEP 38: CHECK PRICE VARIATION
# ============================================================

price_variation = pd.DataFrame({
    "Unique_Prices": master_df.drop(columns="Date").nunique(),
    "Observations": master_df.drop(columns="Date").notna().sum()
})

price_variation = price_variation.sort_values(
    "Unique_Prices"
)

display(price_variation.head(20))


# ============================================================
# STEP 39: FINAL DATE VALIDATION
# ============================================================

print("Date data type:", master_df["Date"].dtype)
print("Missing dates:", master_df["Date"].isna().sum())
print("Duplicate dates:", master_df["Date"].duplicated().sum())
print("Dates sorted:", master_df["Date"].is_monotonic_increasing)
print("Unique dates:", master_df["Date"].nunique())


# ============================================================
# STEP 40: CREATE FINAL MASTER DATASET
# ============================================================

final_master_df = master_df.copy()

# Final safety checks
assert final_master_df["Date"].isna().sum() == 0
assert final_master_df["Date"].duplicated().sum() == 0
assert final_master_df["Date"].is_monotonic_increasing
assert not final_master_df.columns.duplicated().any()

print("SUCCESS: Final master dataset passed all safety checks.")

print("\nShape:", final_master_df.shape)
print("Date range:")
print("Start:", final_master_df["Date"].min().date())
print("End:", final_master_df["Date"].max().date())

print("\nTotal securities/indexes:", len(final_master_df.columns) - 1)


# ============================================================
# STEP 41: SAVE FINAL CLEAN MASTER DATASET
# ============================================================

output_path = "/kaggle/working/NSE_master_clean_2013_2025.csv"

final_master_df.to_csv(
    output_path,
    index=False
)

print("SUCCESS: File saved successfully.")
print("Path:", output_path)
print("Rows:", len(final_master_df))
print("Columns:", len(final_master_df.columns))


# ============================================================
# STEP 42: RELOAD AND VERIFY SAVED FILE
# ============================================================

verification_df = pd.read_csv(
    output_path,
    parse_dates=["Date"]
)

print("Reloaded shape:", verification_df.shape)

print("First date:", verification_df["Date"].min())
print("Last date:", verification_df["Date"].max())

print("Missing dates:", verification_df["Date"].isna().sum())
print("Duplicate dates:", verification_df["Date"].duplicated().sum())
print("Duplicate columns:", verification_df.columns.duplicated().sum())

print("\nOriginal shape:", final_master_df.shape)
print("Reloaded shape:", verification_df.shape)

if final_master_df.shape == verification_df.shape:
    print("\nSUCCESS: Saved file matches the original dataset shape.")
else:
    print("\nWARNING: Shape mismatch detected.")


# ============================================================
# STEP 43: CREATE DATA QUALITY REPORT
# ============================================================

data_quality_report = pd.DataFrame({
    "Metric": [
        "Total Rows",
        "Total Columns",
        "Total Securities/Indexes",
        "Start Date",
        "End Date",
        "Missing Dates",
        "Duplicate Dates",
        "Duplicate Column Names",
        "Completely Empty Columns"
    ],
    "Value": [
        len(final_master_df),
        len(final_master_df.columns),
        len(final_master_df.columns) - 1,
        str(final_master_df["Date"].min().date()),
        str(final_master_df["Date"].max().date()),
        final_master_df["Date"].isna().sum(),
        final_master_df["Date"].duplicated().sum(),
        final_master_df.columns.duplicated().sum(),
        sum(final_master_df[col].isna().all()
            for col in final_master_df.columns)
    ]
})

display(data_quality_report)


# ============================================================
# SAVE DATA QUALITY REPORT
# ============================================================

report_path = "/kaggle/working/NSE_data_quality_report.csv"

data_quality_report.to_csv(
    report_path,
    index=False
)

print("SUCCESS: Data quality report saved.")
print("Path:", report_path)
