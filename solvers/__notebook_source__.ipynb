# ============================================================
# STEP 5: ROBUST DATE PARSING
# ============================================================

def parse_nse_dates(series):
    s = series.astype(str).str.strip()

    # Create empty datetime series
    dates = pd.Series(pd.NaT, index=series.index, dtype="datetime64[ns]")

    # Format 1: YYYY-MM-DD
    iso_mask = s.str.match(r"^\d{4}-\d{2}-\d{2}$")

    dates.loc[iso_mask] = pd.to_datetime(
        s.loc[iso_mask],
        format="%Y-%m-%d",
        errors="coerce"
    )

    # Format 2: DD/MM/YYYY
    slash_mask = s.str.match(r"^\d{2}/\d{2}/\d{4}$")

    dates.loc[slash_mask] = pd.to_datetime(
        s.loc[slash_mask],
        format="%d/%m/%Y",
        errors="coerce"
    )

    return dates


